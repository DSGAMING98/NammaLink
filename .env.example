# Google Maps JavaScript API (browser-visible; restrict by HTTPS referrer and API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Maps Platform web services (server-only; use restricted keys)
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# OpenStreetMap Overpass API (public instances normally require no API key)
OVERPASS_API_URL=

# Optional Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

